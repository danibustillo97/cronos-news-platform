# Copy to .env.local for local development. Never commit the real file.
#
# In Vercel (or any other deploy target), set these as real environment
# variables in the project dashboard -- do not bake real values into this
# repo. NEXT_PUBLIC_* vars are inlined into the client bundle at build
# time, so they are visible to anyone; never put a secret in one.

# Backend API base URL. Leave this UNSET for local dev -- see
# src/studio/lab/api-client.ts: the browser defaults to a relative path
# (so it stays same-origin through Nginx at http://nexus.local, the
# correct local architecture -- Browser -> Nginx :80 -> Backend :8000),
# while server-side rendering defaults to http://localhost:8000 (no
# browser origin to preserve there, and no CORS involved).
# Production MUST set this to the real, separately-deployed backend URL
# -- it is never inferred from NODE_ENV/VERCEL_ENV.
NEXT_PUBLIC_API_BASE_URL=

# Supabase project used for direct client-side reads (Realtime
# subscriptions, and the legacy admin components that still bypass the
# backend -- see docs/NEXUS_ARCHITECTURE_BASELINE.md section 10/13).
# The anon key is meant to be public (protected by RLS policies), but
# still belongs in env vars, not source, so each environment (local /
# staging / production) can point at a different Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://mxvdnfaeqjifnxqmxbri.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TikTok Developer API (OAuth + PKCE) -- server-side only, used by the
# Next.js API routes under src/app/api/tiktok/. Real secrets, never
# NEXT_PUBLIC_*.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_DEMO_MODE=false
