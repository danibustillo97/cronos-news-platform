# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are intentionally unanchored (no leading slash) so they keep
# working both at the current repo layout and after the frontend/backend/rpa
# split (see obsidian-vault/Roadmap.md).

# === JS/Next.js ===
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
coverage/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
.vercel

# === Python (backend/, rpa/) ===
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
*.egg-info/

# === misc ===
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env
.env.*
!.env.example

# === Automation is its own nested git repo (its own .git/.claude, on
# purpose -- see obsidian-vault/Roadmap.md) -- never tracked as regular
# files by NEXUS's own repo, never merged into it. ===
automation/

# === nexus.ps1 runtime state (logs) -- regenerated every `nexus up` ===
.nexus/
