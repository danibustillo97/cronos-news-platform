# Copy to backend/.env for local development. Never commit the real file
# (already gitignored). In staging/production, set these as real process
# environment variables on the host/container -- app/infrastructure/
# persistence/supabase/client.py only fills gaps from this file, real env
# vars always win, so this same code runs unchanged in every environment.

# Supabase project. SUPABASE_URL/SUPABASE_KEY (anon) have safe local
# defaults baked into client.py; SUPABASE_SERVICE_ROLE_KEY does not and is
# required for the backend's own writes (Story/Production/Composition/...).
SUPABASE_URL=https://mxvdnfaeqjifnxqmxbri.supabase.co
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The Local Runtime (automation/runtime/) this backend talks to. Defaults
# to http://localhost:8801 for local dev -- production points this at
# wherever Automation/Runtime is actually deployed (see
# docs/NEXUS_DEPLOYMENT_ARCHITECTURE.md; there is no real deployment
# target for it yet).
RUNTIME_BASE_URL=http://localhost:8801

# Where LAB's export bundles live on disk (automation/lab/workspace/exports).
# Only needed if the default relative path (computed from this file's own
# location, see app/infrastructure/lab/local/export_reader.py) doesn't
# apply -- e.g. Automation deployed on a different host than the backend.
LAB_WORKSPACE_PATH=

# Comma-separated extra CORS origins on top of the local defaults
# (localhost:3000, nexus.local, localhost) -- set this to the real
# frontend URL(s) in staging/production (e.g. a Vercel deployment URL).
CORS_ALLOWED_ORIGINS=

# Provider Control Plane (app/infrastructure/llm/) -- Artifact's real LLM
# call, one of two interchangeable providers a human picks per job (or
# ARTIFACT_PROVIDER decides for "auto"). Missing/invalid credentials never
# block startup -- POST /api/artifacts/jobs still creates a real job and
# runs it, it just fails honestly (job status FAILED, real error message)
# instead of generating content. Never invent a key here; use Settings ->
# Providers in the running app to set/replace ANTHROPIC_API_KEY instead of
# editing this file by hand -- it writes here and reloads it in-process.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Claude Code CLI provider (app/infrastructure/llm/claude_code_adapter.py)
# -- a real, local, non-interactive `claude -p` subprocess call. Only
# works where the `claude` binary is installed and authenticated (this
# dev machine); a cloud deployment without it reports this provider
# UNAVAILABLE, honestly, never a silent fallback. CLAUDE_CODE_BINARY
# overrides the PATH lookup if needed; leave both unset for the default
# ("claude" on PATH, model "claude-sonnet-5").
CLAUDE_CODE_BINARY=
CLAUDE_CODE_MODEL=

# Default Artifact provider when a job doesn't pick one explicitly.
# auto (try the configured default, then whichever real provider is
# actually usable) | anthropic | claude_code. Settings -> Providers'
# "Set as default" writes this the same way it writes an API key.
ARTIFACT_PROVIDER=auto
