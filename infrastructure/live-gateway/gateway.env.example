# Copia este archivo como gateway.env y completa tus datos (gateway.env NO se sube a git).

# Kick: Creator Dashboard -> Settings -> Stream URL & Key
KICK_URL=rtmps://fa723fc1b171.global-contribute.live-video.net:443/app
KICK_KEY=

# TikTok LIVE: server URL y stream key (LIVE Studio / LIVE Producer). Déjalo vacío si no transmites a TikTok.
TIKTOK_URL=
TIKTOK_KEY=

# Calidad de video enviada a Kick y TikTok
VIDEO_BITRATE=4500k
VIDEO_FPS=30

# Zeno.fm: Broadcast settings -> Icecast/Shoutcast (host, puerto, mount y password de la fuente)
ZENO_HOST=link.zeno.fm
ZENO_PORT=80
ZENO_MOUNT=
ZENO_PASSWORD=
RADIO_BITRATE=128k
