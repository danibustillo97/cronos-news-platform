# Supabase -> Project Settings -> API Keys. Secret key (antes service_role).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Feeds RSS/Atom separados por coma o salto de línea. Pista de categoría opcional: url|Fútbol
SCRAPER_SOURCES=
# Opcionales. Por defecto: 48 h de antigüedad (0 = sin límite), 15 por feed,
# 60 por pasada, texto completo activado (0 = solo feed), 15 s por petición.
SCRAPER_MAX_AGE_HOURS=
SCRAPER_MAX_ITEMS_PER_SOURCE=
SCRAPER_MAX_NEW_ITEMS=
SCRAPER_FETCH_FULL_TEXT=
SCRAPER_TIMEOUT=
# Solo para el modo automático
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
